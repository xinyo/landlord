{
  "name": "landlord",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:wechat": "tsc -b && vite build --mode wechat",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:wechat": "vite preview --outDir dist-wechat",
    "android": "corepack pnpm --dir apps/mobile start",
    "android:setup": "corepack pnpm --dir apps/mobile android:setup",
    "build:android": "node scripts/build-android.mjs",
    "build:andriod": "node scripts/build-android.mjs",
    "assets:android": "node scripts/generate-mobile-assets.mjs",
    "test:web": "vitest run",
    "test": "vitest run && corepack pnpm --filter @landlord/core test && corepack pnpm --filter @landlord/mobile test",
    "typecheck": "tsc -b && corepack pnpm --filter @landlord/core typecheck && corepack pnpm --filter @landlord/mobile typecheck"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.33.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@landlord/core": "workspace:*",
    "framer-motion": "^12.34.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.7",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
